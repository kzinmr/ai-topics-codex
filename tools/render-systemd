#!/usr/bin/env python3
"""Print a user service; does not install or start it."""

import argparse
import os
from pathlib import Path

p = argparse.ArgumentParser()
p.add_argument("--profile", type=Path, required=True)
p.add_argument("--python", type=Path, required=True)
a = p.parse_args()
source = Path(__file__).resolve().parents[1]


def quote(value):
    value = str(value)
    if any(c in value for c in "\n\r\0"):
        raise ValueError("unit values cannot contain control characters")
    return (
        '"' + value.replace("\\", "\\\\").replace('"', '\\"').replace("%", "%%") + '"'
    )


entry = (
    quote(source / "bin/ai-topics-codex") + " --profile " + quote(a.profile.resolve())
)
print(
    "[Unit]\nDescription=AI Topics Lucy scheduler\nAfter=network-online.target\n\n[Service]\nType=simple"
)
quote(source)  # validate control characters; systemd paths do not use shell quotes
print("WorkingDirectory=" + str(source).replace("%", "%%"))
print("Environment=" + quote("AI_TOPICS_PYTHON=" + str(a.python.absolute())))
print(
    "Environment="
    + quote("PATH=" + os.environ.get("PATH", "/usr/local/bin:/usr/bin:/bin"))
)
print("ExecStartPre=" + entry + " sandbox-check")
print("ExecStart=" + entry + " serve")
print(
    "Restart=on-failure\nRestartSec=30\nKillMode=control-group\nTimeoutStopSec=30\nUMask=0077"
)
print(
    "NoNewPrivileges=yes\nTasksMax=256\nMemoryMax=4G\n\n[Install]\nWantedBy=default.target"
)
